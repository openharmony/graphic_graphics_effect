struct [[ge::params(type=ATLAS_FRAME_MASK, name="AtlasFrameMask")]] GEXAtlasFrameMaskParams {
    std::shared_ptr<Drawing::Image> image = nullptr;
    [[ge::prop(min=0.0f, max=8192.0f)]]
    float frameIndex = -1.f;
    [[ge::prop(min=1, max=8192)]]
    int32_t cols = 0;
    [[ge::prop(min=1, max=8192)]]
    int32_t rows = 0;
    [[ge::prop(min=1.0f, max=8192.0f)]]
    float frameWidth = 0.f;
    [[ge::prop(min=1.0f, max=8192.0f)]]
    float frameHeight = 0.f;
    [[ge::prop(min=0.0f, max=64.0f)]]
    float padding = 0.f;
    [[ge::prop(min=0, max=1)]]
    int32_t mode = 0;
    [[ge::prop(min=1, max=8192)]]
    int32_t totalFrame = 0;
};
